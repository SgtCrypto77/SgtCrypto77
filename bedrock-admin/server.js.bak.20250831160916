// ---------- Simple validators ----------
function findDates(s){
  // yyyy-mm-dd, mm/dd/yyyy, Month YYYY
  const re = /\b(\d{4}-\d{2}-\d{2}|\d{1,2}\/\d{1,2}\/\d{2,4}|(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)[a-z]*\s+\d{4})\b/ig;
  const out = new Set(); let m;
  while ((m = re.exec(s))) out.add(m[1]);
  return Array.from(out).slice(0,25);
}

function validatePacket(allText){
  const issues = [];

  // PII leaks (should be redacted by splitDocsToFacts, but double-check raw text)
  if (/\b\d{3}[-\s]?\d{2}[-\s]?\d{4}\b/.test(allText)) {
    issues.push({type:'pii', msg:'Possible SSN present (not fully redacted).'});
  }
  if (/\b(DOB|Date of Birth)\b\s*[:\-]?\s*\d{1,2}[\/\-]\d{1,2}[\/\-]\d{2,4}\b/i.test(allText)) {
    issues.push({type:'pii', msg:'DOB appears in clear text; redact.'});
  }

  // “DRAFT”, “SAMPLE”, or watermark words
  if (/\b(DRAFT|SAMPLE|WATERMARK)\b/i.test(allText)) {
    issues.push({type:'doc_quality', msg:'Found “DRAFT/SAMPLE/WATERMARK” text; replace with final signed version.'});
  }

  // Very long blank runs / scanned garbage hint
  if ((allText.match(/\n\s*\n/g)||[]).length > 400) {
    issues.push({type:'ocr', msg:'Large amounts of blank/whitespace detected; OCR may be incomplete—rerun with options.ocr=true.'});
  }

  // Dates sanity (future or pre-1900)
  const years = Array.from(allText.matchAll(/\b(18|19|20)\d{2}\b/g)).map(m=>+m[0]);
  const outOfRange = years.filter(y => y < 1900 || y > (new Date().getFullYear()+1));
  if (outOfRange.length) {
    issues.push({type:'dates', msg:`Out-of-range years found: ${Array.from(new Set(outOfRange)).slice(0,10).join(', ')}`});
  }

  // Missing signatures hint
  if (!/signature|signed|/i.test(allText)) {
    issues.push({type:'signatures', msg:'Could not find any “signature/signed” text; double-check signature pages are included.'});
  }

  // Lay statement basics present?
  const hasVA21_4138 = /\b21[-\s]?4138\b/.test(allText) || /Statement\s+in\s+Support\s+of\s+Claim/i.test(allText);
  if (!hasVA21_4138) {
    issues.push({type:'lay_statements', msg:'No VA Form 21-4138 / lay statements detected. Consider adding (Veteran & witness/caregiver).'});
  }

  // Key evidence hints
  const hasSSA = /\bSSA\b|\bSocial Security\b/i.test(allText);
  if (!hasSSA) {
    issues.push({type:'evidence', msg:'No SSA disability evidence detected; include if applicable.'});
  }
  const hasROM = /\bflexion\b|\bextension\b|\brange of motion\b/i.test(allText);
  if (!hasROM) {
    issues.push({type:'evidence', msg:'No Range-of-Motion measurements detected; include C&P/ROM pages if lumbar/cervical issues are central.'});
  }

  // Extract a small “timeline” from the first N lines with dates
  const lines = allText.split(/\r?\n/);
  const dated = [];
  for (const ln of lines) {
    const dg = findDates(ln);
    if (dg.length) dated.push({date: dg[0], snippet: ln.trim().slice(0,140)});
    if (dated.length >= 25) break;
  }

  return { issues, timeline: dated };
}

// ---------- Lay statement drafting ----------
function pickSnippets(facts){
  const lines = facts.map(f=>f.line.toLowerCase());
  const hits = (kw) => lines.filter(l => l.includes(kw)).slice(0,5);
  return {
    pain: hits('pain'),
    rom: facts.filter(f=>/\bflexion|extension|range of motion\b/i.test(f.line)).slice(0,5).map(f=>f.line),
    mh: hits('ptsd').concat(hits('anxiety')).concat(hits('depress')),
    work: lines.filter(l=>/\b(ssa|unable to work|unemploy|tdiu)\b/.test(l)).slice(0,5),
    aanda: lines.filter(l=>/\b(aid and attendance|a&a)\b/.test(l)).slice(0,5)
  };
}

function draftLayStatements(claimantName, facts){
  const name = claimantName || 'Veteran';
  const dates = [];
  facts.forEach(f => findDates(f.line).forEach(d=>dates.push(d)));
  const uniqDates = Array.from(new Set(dates)).slice(0,6);
  const snips = pickSnippets(facts);

  const veteranText =
`STATEMENT IN SUPPORT OF CLAIM (Lay Statement)
Claimant: ${name}
Date: ${new Date().toISOString().slice(0,10)}

Purpose
I am submitting this lay statement to explain the history and current severity of my conditions and how they affect daily functioning and work.

Timeline (key dates observed in my record):
- ${uniqDates.join('\n- ') || '(dates summarized in file)'}

Functional Impact (plain language)
- Symptoms: ${snips.pain[0] ? 'persistent pain; ' : ''}${snips.mh[0] ? 'sleep disturbance/mental health symptoms; ' : ''}${snips.rom.length ? 'limited range of motion; ' : ''}(see records).
- Daily life: I need extra time for basic tasks, avoid lifting/twisting, and have frequent flare-ups that cause missed activities.
- Work: ${snips.work.length ? 'My record reflects unemployability concerns/SSA involvement.' : 'My conditions have limited my ability to keep regular work hours.'}

Credibility
I certify this statement is true to the best of my knowledge.

Signature: ____________________________   Date: __________
`;

  const caregiverText =
`WITNESS/CARGIVER LAY STATEMENT
Declarant: ____________________________   Relation: __________________
For: ${name}
Date: ${new Date().toISOString().slice(0,10)}

Observations
- I regularly observe the Veteran experiencing limitations such as ${snips.pain[0] ? 'pain episodes' : 'pain'}, ${snips.rom.length ? 'restricted motion' : 'mobility limits'}, and ${snips.mh[0] ? 'sleep disturbances/mental health symptoms' : 'fatigue'}.
- Assistance provided: reminders for meds/appointments, help with chores and transportation${snips.aanda.length ? '; need for Aid & Attendance is consistent with records' : ''}.

Frequency & Severity
- Symptoms occur on most days, with weekly flare-ups that require rest and assistance.

Certification
I certify this statement is true to the best of my knowledge.

Signature: ____________________________   Date: __________
`;

  return { veteranText, caregiverText };
}

// ---------- Make a quick PDF from plain text ----------
function writeTextPdf(title, body, outBase){
  const id = outBase + '-' + crypto.randomUUID() + '.pdf';
  const outPath = path.join(BRIEFS, id);
  return new Promise((resolve, reject)=>{
    try{
      const doc = new PDFDocument({size:'LETTER', margin:48});
      const stream = fs.createWriteStream(outPath);
      stream.on('error', reject);
      doc.on('error', reject);
      doc.pipe(stream);
      doc.fontSize(16).text(title, {align:'center'});
      doc.moveDown().fontSize(11).text(body, {align:'left'});
      doc.end();
      stream.on('finish', ()=> resolve({ filename:id, url: `${PUBLIC}/briefs-stub/${id}` }));
    }catch(e){ reject(e); }
  });
}

// ---------- Collect all text for a set of files ----------
function collectText(files, tryOcr){
  let text = '';
  for (const f of files){
    const p = path.join(UPLOADS, path.basename(f));
    if (!fs.existsSync(p)) continue;
    const t = extractTextFromPdf(p, tryOcr);
    text += '\n' + (t || '');
  }
  return text;
}

// ---------- /admin/validate ----------
app.post('/admin/validate', (req,res)=>{
  try{
    const files = Array.isArray(req.body?.files) ? req.body.files : [];
    const tryOcr = !!(req.body?.options && req.body.options.ocr);
    const text = files.length ? collectText(files, tryOcr) : '';
    const report = validatePacket(text);
    res.json({ok:true, report});
  }catch(e){
    res.status(500).json({ok:false, error: e?.message || String(e)});
  }
});

// ---------- /admin/draft-lay ----------
app.post('/admin/draft-lay', async (req,res)=>{
  try{
    const claimant = req.body?.claimant || {};
    const files = Array.isArray(req.body?.files) ? req.body.files : [];
    const tryOcr = !!(req.body?.options && req.body.options.ocr);

    // Build facts from provided files (reusing existing splitter with redaction)
    let facts = [];
    for (const f of files){
      const p = path.join(UPLOADS, path.basename(f));
      if (!fs.existsSync(p)) continue;
      const txt = extractTextFromPdf(p, tryOcr);
      facts = facts.concat(splitDocsToFacts(txt || '', path.basename(f)));
    }

    const drafts = draftLayStatements(claimant.name, facts);
    const vetPdf = await writeTextPdf('Veteran Lay Statement', drafts.veteranText, 'lay-veteran');
    const cgPdf  = await writeTextPdf('Witness/Caregiver Lay Statement', drafts.caregiverText, 'lay-caregiver');
    res.json({ok:true, drafts, pdfs:{veteran:vetPdf, caregiver:cgPdf}});
  }catch(e){
    res.status(500).json({ok:false, error: e?.message || String(e)});
  }
});
