// ===== Decision-letter parsing & CUE rebuttal =====

// Extract common sections from a VA decision letter
function extractDecisionSections(text){
  const T = String(text||'');
  function sect(label, patterns){
    let start = -1, end = T.length;
    for (const re of patterns){
      const m = T.match(re);
      if (m && m.index !== undefined){ start = m.index + m[0].length; break; }
    }
    if (start<0) return '';
    // end at next section header
    const next = [
      /(?:\n|\r)\s*(REASONS (?:AND BASES )?FOR DECISION|EVIDENCE|DECISION|FINDINGS OF FACT|CONCLUSIONS OF LAW)\s*:?\s*\n/ig
    ];
    let best = end;
    for (const re of next){
      let m;
      while ((m = re.exec(T))){
        if (m.index > start && m.index < best){ best = m.index; break; }
      }
    }
    return T.slice(start, best).trim();
  }
  return {
    evidence: sect('evidence', [/^\s*EVIDENCE\s*:?\s*$/im]),
    reasons:  sect('reasons',  [/^\s*REASONS (?:AND BASES )?FOR DECISION\s*:?\s*$/im]),
    decision: sect('decision', [/^\s*DECISION\s*:?\s*$/im]),
    findings: sect('findings', [/^\s*FINDINGS OF FACT\s*:?\s*$/im]),
    conclusions: sect('conclusions', [/^\s*CONCLUSIONS OF LAW\s*:?\s*$/im]),
    raw: T
  };
}

function normalize(s){ return String(s||'').replace(/\s+/g,' ').toLowerCase(); }

// Try to detect classic denial rationales we need to neutralize for CUE
function detectDenialThemes(dec){
  const d = normalize(dec.raw);
  return {
    invokesWeightOfEvidence: /\b(weight|weighed|preponderance)\b/.test(d),
    invokesBenefitOfDoubt: /\bbenefit of the doubt\b/.test(d),
    saysNoCUEBecauseDisagreement: /\b(disagreement|difference of opinion)\b.+(not|isn't|is not).+CUE/.test(d),
    ignoresSSA: !/\bssa\b|\bsocial security\b/.test(d),
    ignoresTDIU: !/\btdiu\b|\bunemploy/i.test(d),
  };
}

// Evidence “signals” pulled from your facts
function scanEvidenceSignals(facts){
  const lines = facts.map(f=>f.line);
  const cat = (re,max=8)=> lines.filter(l=>re.test(l)).slice(0,max);
  return {
    ssnResiduals: cat(/\*\*\*-\*\*-?\*{4}/i),
    rom:          cat(/\b(flexion|extension|range of motion|°|deg)\b/i),
    mh:           cat(/\bptsd|anxiety|depress|gaf\b/i),
    ssa:          cat(/\bssa\b|\bsocial security\b/i),
    aanda:        cat(/\b(aid and attendance|a&a)\b/i),
    unemploy:     cat(/\bunemploy|unable to work|tdiu\b/i),
    dates:        Array.from(new Set((lines.join('\n').match(/\b(?:\d{4}-\d{2}-\d{2}|\d{1,2}[\/-]\d{1,2}[\/-]\d{2,4})\b/g)||[]))).slice(0,10)
  };
}

// Build a CUE-focused issues matrix
function buildCueIssues(dec, facts){
  const themes = detectDenialThemes(dec);
  const sigs = scanEvidenceSignals(facts);
  const issues = [];

  // 1) Wrong legal standard / reasons & bases
  if (themes.invokesBenefitOfDoubt || themes.invokesWeightOfEvidence || themes.saysNoCUEBecauseDisagreement){
    issues.push({
      type: 'misapplied_law',
      cite: '38 C.F.R. § 3.105(a); Russell v. Principi, 3 Vet.App. 310 (1992) (en banc); Damrel v. Brown, 6 Vet.App. 242 (1994); Fugo v. Brown, 6 Vet.App. 40 (1993).',
      decision_excerpt: (dec.reasons || dec.conclusions || dec.raw).slice(0,400),
      why_erroneous: 'CUE analysis does not use “benefit of the doubt” or weighing of evidence; it asks whether the correct facts were before the adjudicator and the law extant at the time was correctly applied AND the error is undebatable and outcome determinative.',
      closer: 'The denial’s reliance on doubt/weight language is non-responsive to §3.105(a) and controlling caselaw.'
    });
  }

  // 2) Failure to discuss favorable evidence (SSA / unemploy / ROM)
  if (sigs.ssa.length && themes.ignoresSSA){
    issues.push({
      type: 'reasons_bases',
      cite: '38 U.S.C. § 7104(d)(1); Gilbert v. Derwinski, 1 Vet.App. 49 (1990).',
      decision_excerpt: (dec.reasons||'').slice(0,300),
      record_evidence: sigs.ssa,
      why_erroneous: 'The decision fails to address favorable SSA disability evidence reasonably raised by the record.'
    });
  }
  if (sigs.unemploy.length && themes.ignoresTDIU){
    issues.push({
      type: 'duty_to_maximize / inferred TDIU',
      cite: '38 C.F.R. § 4.16; Roberson v. Principi, 251 F.3d 1378 (Fed. Cir. 2001).',
      record_evidence: sigs.unemploy,
      why_erroneous: 'TDIU was reasonably raised by the record, requiring consideration; omission is error.'
    });
  }
  if (sigs.rom.length && !/\brange of motion|flexion|extension|°|deg\b/i.test(dec.raw)){
    issues.push({
      type: 'reasons_bases',
      cite: '38 U.S.C. § 7104(d)(1).',
      record_evidence: sigs.rom,
      why_erroneous: 'Objective ROM findings are not analyzed in Reasons/Bases.'
    });
  }

  // 3) Effective date logic for CUE (if “effective date” present)
  if (/\beffective date\b/i.test(dec.raw) && !/3\.400|3\.400\(k\)/i.test(dec.raw)){
    issues.push({
      type: 'effective_date',
      cite: '38 C.F.R. § 3.400(k).',
      why_erroneous: 'CUE revision effective date must follow §3.400(k); the decision does not apply it.'
    });
  }

  return { themes, signals: sigs, issues };
}

// Turn the matrix into strong, “close the loop” language
function draftCueRebuttalLanguage(claimant, sections, analysis){
  const name = claimant?.name || 'Veteran';
  return `HLR REBUTTAL – CUE DENIAL
Claimant: ${name}
Date: ${new Date().toISOString().slice(0,10)}

Introduction
This rebuttal challenges the CUE denial. The allegation is not a disagreement with how evidence was weighed. It is an undebatable legal error, outcome-determinative, under 38 C.F.R. § 3.105(a).

Standard (controlling authority)
- 38 C.F.R. § 3.105(a) (revision for CUE).
- Russell v. Principi, 3 Vet.App. 310 (1992) (en banc); Damrel v. Brown, 6 Vet.App. 242 (1994); Fugo v. Brown, 6 Vet.App. 40 (1993).
- Reasons/Bases: 38 U.S.C. § 7104(d)(1); Gilbert v. Derwinski, 1 Vet.App. 49 (1990).
- Duty to maximize / inferred TDIU: Roberson v. Principi, 251 F.3d 1378 (Fed. Cir. 2001).
${/\beffective date\b/i.test(sections.raw)?'- Effective date on CUE revision: 38 C.F.R. § 3.400(k).\n':''}

Decision excerpts (for context)
${(sections.reasons || sections.decision || '').slice(0,800)}

Specific errors and why they are CUE (not weighing):
${analysis.issues.map((it,i)=>`${i+1}. [${it.type}] ${it.why_erroneous}${it.record_evidence?`\n   Favorable record snippets:\n   - ${it.record_evidence.slice(0,4).join('\n   - ')}`:''}\n   Authority: ${it.cite}`).join('\n\n') || '(No explicit issues detected; attach full letter and rerun with OCR=true).'}

Outcome-determinative connection
Given the law extant at the time and the record facts (attached), applying the correct standard would have manifestly changed the outcome. This is a legal defect, not an evidentiary re-weighing; “benefit of the doubt” and rater discretion are inapposite in a §3.105(a) analysis.

Relief Requested
- Revise the prior decision pursuant to 38 C.F.R. § 3.105(a).
${/\beffective date\b/i.test(sections.raw)?'- Assign the proper effective date under 38 C.F.R. § 3.400(k).\n':''}
- Address all favorable evidence and provide adequate Reasons/Bases if any benefit remains denied.`;
}

